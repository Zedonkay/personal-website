---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}
{% assign url_beginning = page.url | slice: 0, 6 %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      Created on {{ page.date | date: '%B %d, %Y' }}
      {% if page.author %}by {{ page.author }}{% endif %}
      {% if page.last_updated %}, last updated on {{ page.last_updated | date: '%B %d, %Y' }}{% endif %}
      {% if page.meta %}• {{ page.meta }}{% endif %}
    </p>
    <p class="post-tags">
      {% if url_beginning == '/blog/' %}
        <a href="{{ '/blog/' | relative_url }}#year-{{ year }}"> <i class="fa-solid fa-calendar fa-sm"></i> {{ year }} </a>
      {% else %}
        <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}
      {% endif %}
      {% if tags != '' %}
        &nbsp; &middot; &nbsp;
        {% for tag in page.tags %}
          {% if url_beginning == '/blog/' %}
            <a href="{{ '/blog/' | relative_url }}#tag-{{ tag | slugify }}"> <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}</a>
          {% else %}
            <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}
          {% endif %}
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}

      {% if categories != '' %}
        &nbsp; &middot; &nbsp;
        {% for category in page.categories %}
          {% if url_beginning == '/blog/' %}
            <a href="{{ '/blog/' | relative_url }}#category-{{ category | slugify }}"> <i class="fa-solid fa-tag fa-sm"></i> {{ category -}}</a>
          {% else %}
            <i class="fa-solid fa-tag fa-sm"></i> {{ category }}
          {% endif %}
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}
      {% if page.form %}
        &nbsp; &middot; &nbsp;
        {% if url_beginning == '/blog/' %}
          <a href="{{ '/blog/' | relative_url }}#form-{{ page.form | slugify }}">
            <i class="fa-solid fa-feather fa-sm"></i> {% include form_label.liquid slug=page.form -%}
          </a>
        {% else %}
          <i class="fa-solid fa-feather fa-sm"></i> {% include form_label.liquid slug=page.form %}
        {% endif %}
      {% endif %}
      {% if page.series %}
        &nbsp; &middot; &nbsp;
        {% if url_beginning == '/blog/' %}
          <a href="{{ '/blog/' | relative_url }}#series-{{ page.series | slugify }}">
            <i class="fa-solid fa-bookmark fa-sm"></i> {% include series_label.liquid slug=page.series -%}
          </a>
        {% else %}
          <i class="fa-solid fa-bookmark fa-sm"></i> {% include series_label.liquid slug=page.series %}
        {% endif %}
      {% endif %}
    </p>
  </header>

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% include series_nav.liquid %}

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --group_by none --cited_in_order %}
    </div>
  {% endif %}

  {% if site.related_blog_posts and site.related_blog_posts.enabled %}
    {% if page.related_posts == null or page.related_posts %}
      {% assign series_posts = site.posts | where: 'series', page.series %}
      {% if page.series == null or series_posts.size <= 1 %}
        {% include related_posts.liquid %}
      {% endif %}
    {% endif %}
  {% endif %}

  {% if site.disqus_shortname and page.disqus_comments %}
    {% include disqus.liquid %}
  {% endif %}
  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
