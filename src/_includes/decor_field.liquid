  <template id="charm-hammer">
    <div class="decor-placed decor-charm decor-charm-hammer">
      <svg class="charm-svg charm-clipart" viewBox="-82 -82 156 166" focusable="false">
        <polygon class="charm-fill" points="-15,80 -15,-40 -80,-40 -40,-80 70,-80 70,-40 15,-40 15,80"></polygon>
      </svg>
    </div>
