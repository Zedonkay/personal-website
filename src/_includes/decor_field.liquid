<div class="decor-field" aria-hidden="true">
  <div class="decor-layer" id="decor-layer"></div>

  <template id="charm-teapot">
    <div class="decor-placed decor-charm decor-charm-teapot">
      <svg class="charm-steam" viewBox="0 0 28 40" focusable="false">
        <path class="steam-a" d="M10 38c1-7-1-12-2-18s1-10 3-16"></path>
        <path class="steam-b" d="M18 36c2-7 0-12-1-18s2-10 3-15"></path>
      </svg>
      <svg class="charm-svg" viewBox="0 0 120 82" focusable="false">
        <path class="charm-line" d="M86 36c18 0 20 30-2 32"></path>
        <ellipse class="charm-fill" cx="58" cy="52" rx="28" ry="20"></ellipse>
        <ellipse class="charm-fill" cx="58" cy="34" rx="15" ry="4.2"></ellipse>
        <circle class="charm-fill" cx="58" cy="24" r="2.8"></circle>
        <path class="charm-line charm-spout" d="M31 44c-12-3-19-14-18-24"></path>
      </svg>
    </div>
  </template>

  <template id="charm-cup">
    <div class="decor-placed decor-charm decor-charm-cup">
      <svg class="charm-steam" viewBox="0 0 28 40" focusable="false">
        <path class="steam-a" d="M12 38c1-8 0-13-1-20s1-10 2-16"></path>
      </svg>
      <svg class="charm-svg" viewBox="0 0 70 56" focusable="false">
        <ellipse class="charm-fill" cx="30" cy="48" rx="20" ry="4"></ellipse>
        <path class="charm-fill" d="M14 22h32c1 11-2 22-16 22S13 32 14 22z"></path>
        <path class="charm-line" d="M45 26c6 1 7 12 0 14"></path>
        <ellipse class="charm-fill" cx="30" cy="22" rx="16" ry="2.8"></ellipse>
      </svg>
    </div>
  </template>

  <template id="charm-coffee">
    <div class="decor-placed decor-charm decor-charm-coffee">
      <svg class="charm-steam" viewBox="0 0 28 40" focusable="false">
        <path class="steam-a" d="M10 38c2-8 0-14-1-20s2-10 3-16"></path>
        <path class="steam-b" d="M18 36c1-7 1-12 0-18s1-9 2-14"></path>
      </svg>
      <svg class="charm-svg" viewBox="0 0 70 52" focusable="false">
        <path class="charm-fill" d="M14 14h32c1 11-1 24-16 24S13 24 14 14z"></path>
        <path class="charm-line" d="M45 18c6 1 7 12 0 14"></path>
        <ellipse class="charm-fill" cx="30" cy="14" rx="16" ry="2.6"></ellipse>
      </svg>
    </div>
  </template>

  <template id="charm-bike">
    <div class="decor-placed decor-charm decor-charm-bike">
      <svg class="charm-svg" viewBox="12 14 76 58" focusable="false">
        <path
          class="charm-line"
          d="m64 30-12 26-17-19 1-2h27l10 21H52M28 57l11-31h6m12 3h10M27 43a13 13 0 1 0 1 0m44 0a13 13 0 1 0 1 0"
        ></path>
      </svg>
    </div>
  </template>

  <template id="charm-clapper">
    <div class="decor-placed decor-charm decor-charm-clapper">
      <svg class="charm-svg charm-clipart" viewBox="0 0 24 24" focusable="false">
        <path class="charm-fill" d="M20.2 6 3 11l-.9-2.4c-.3-1.1.3-2.2 1.3-2.5l13.5-4c1.1-.3 2.2.3 2.5 1.3Z"></path>
        <path class="charm-line" d="m6.2 5.3 3.1 3.9M9.3 4.4 12.4 8.3M12.4 3.4 15.5 7.4"></path>
        <path class="charm-fill" d="M3 11h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"></path>
      </svg>
    </div>
  </template>

  <template id="charm-pin">
    <div class="decor-placed decor-charm decor-charm-pin">
      <svg class="charm-svg" viewBox="0 0 120 28" focusable="false">
        <rect class="charm-fill" x="24" y="9" width="72" height="10" rx="5"></rect>
        <rect class="charm-fill" x="4" y="11" width="20" height="6" rx="2"></rect>
        <rect class="charm-fill" x="96" y="11" width="20" height="6" rx="2"></rect>
      </svg>
    </div>
  </template>

  <template id="charm-masks">
    <div class="decor-placed decor-charm decor-charm-masks">
      <svg class="charm-svg" viewBox="0 0 88 52" focusable="false">
        <path class="charm-fill" d="M8 10c10-8 26-8 32 2 2 14-6 28-16 30C14 40 4 28 8 10z"></path>
        <path class="charm-line" d="M18 22h4M30 22h4M18 32c6 6 12 6 18 0"></path>
        <path class="charm-fill" d="M48 10c10-8 26-8 32 2 2 14-6 28-16 30C54 40 44 28 48 10z"></path>
        <path class="charm-line" d="M58 22h4M70 22h4M58 34c6-6 12-6 18 0"></path>
      </svg>
    </div>
  </template>

  <template id="charm-hammer">
    <div class="decor-placed decor-charm decor-charm-hammer">
      <svg class="charm-svg" viewBox="0 0 24 24" focusable="false">
        <path class="charm-line" d="M11.414 10l-7.383 7.418a2.091 2.091 0 0 0 0 2.967a2.11 2.11 0 0 0 2.976 0l7.407-7.385"></path>
        <path class="charm-line" d="M18.121 15.293l2.586-2.586a1 1 0 0 0 0-1.414l-7.586-7.586a1 1 0 0 0-1.414 0l-2.586 2.586a1 1 0 0 0 0 1.414l7.586 7.586a1 1 0 0 0 1.414 0z"></path>
      </svg>
    </div>
  </template>

  <template id="charm-record">
    <div class="decor-placed decor-record-wrap">
      {% include decor_record.liquid class="decor-record" %}
    </div>
  </template>
</div>
