<div class="decor-field" aria-hidden="true">
  <div class="decor-layer" id="decor-layer"></div>

  <template id="charm-teapot">
    <div class="decor-placed decor-charm decor-charm-teapot">
      <svg class="charm-steam" viewBox="0 0 28 40" focusable="false">
        <path class="steam-a" d="M10 38c1-7-1-12-2-18s1-10 3-16"></path>
        <path class="steam-b" d="M18 36c2-7 0-12-1-18s2-10 3-15"></path>
      </svg>
      <svg class="charm-svg" viewBox="0 0 108 78" focusable="false">
        <path class="charm-line" d="M78 34c16 1 18 26 1 30"></path>
        <ellipse class="charm-fill" cx="50" cy="48" rx="30" ry="22"></ellipse>
        <path class="charm-fill" d="M22 40c-14 4-20 12-18 20 10-4 16-8 24-12z"></path>
        <ellipse class="charm-fill" cx="50" cy="28" rx="16" ry="4.2"></ellipse>
        <circle class="charm-fill" cx="50" cy="20" r="2.6"></circle>
      </svg>
    </div>
  </template>

  <template id="charm-cup">
    <div class="decor-placed decor-charm decor-charm-cup">
      <svg class="charm-steam" viewBox="0 0 28 40" focusable="false">
        <path class="steam-a" d="M12 38c1-8 0-13-1-20s1-10 2-16"></path>
      </svg>
      <svg class="charm-svg" viewBox="0 0 72 58" focusable="false">
        <ellipse class="charm-fill" cx="30" cy="50" rx="22" ry="5"></ellipse>
        <path class="charm-fill" d="M12 24h36c1 10-2 22-18 22S11 34 12 24z"></path>
        <path class="charm-line" d="M48 28c10 2 10 16 0 18"></path>
        <ellipse class="charm-fill" cx="30" cy="24" rx="18" ry="3.4"></ellipse>
      </svg>
    </div>
  </template>

  <template id="charm-coffee">
    <div class="decor-placed decor-charm decor-charm-coffee">
      <svg class="charm-steam" viewBox="0 0 28 40" focusable="false">
        <path class="steam-a" d="M10 38c2-8 0-14-1-20s2-10 3-16"></path>
        <path class="steam-b" d="M18 36c1-7 1-12 0-18s1-9 2-14"></path>
      </svg>
      <svg class="charm-svg" viewBox="0 0 72 56" focusable="false">
        <path class="charm-fill" d="M12 14h36c1 12-1 28-18 28S11 26 12 14z"></path>
        <path class="charm-line" d="M48 18c12 2 12 18 0 20"></path>
        <ellipse class="charm-fill" cx="30" cy="14" rx="18" ry="3.2"></ellipse>
      </svg>
    </div>
  </template>

  <template id="charm-bike">
    <div class="decor-placed decor-charm decor-charm-bike">
      <svg class="charm-svg" viewBox="0 0 96 58" focusable="false">
        <circle class="charm-line" cx="20" cy="38" r="16"></circle>
        <circle class="charm-line" cx="76" cy="38" r="16"></circle>
        <circle class="charm-hole" cx="20" cy="38" r="3"></circle>
        <circle class="charm-hole" cx="76" cy="38" r="3"></circle>
        <path class="charm-line" d="M20 38l26-22 18 4 12 18H50L20 38M46 16l8-10M68 20l10-12h8M42 16h18"></path>
      </svg>
    </div>
  </template>

  <template id="charm-reel">
    <div class="decor-placed decor-charm decor-charm-reel">
      <svg class="charm-svg" viewBox="0 0 80 80" focusable="false">
        <circle class="charm-fill" cx="40" cy="40" r="36"></circle>
        <circle class="charm-line" cx="40" cy="40" r="28"></circle>
        <circle class="charm-hole" cx="40" cy="40" r="8"></circle>
        <circle class="charm-hole" cx="40" cy="18" r="5"></circle>
        <circle class="charm-hole" cx="59" cy="29" r="5"></circle>
        <circle class="charm-hole" cx="59" cy="51" r="5"></circle>
        <circle class="charm-hole" cx="40" cy="62" r="5"></circle>
        <circle class="charm-hole" cx="21" cy="51" r="5"></circle>
        <circle class="charm-hole" cx="21" cy="29" r="5"></circle>
      </svg>
    </div>
  </template>

  <template id="charm-pin">
    <div class="decor-placed decor-charm decor-charm-pin">
      <svg class="charm-svg" viewBox="0 0 120 32" focusable="false">
        <rect class="charm-fill" x="22" y="10" width="76" height="12" rx="6"></rect>
        <rect class="charm-fill" x="2" y="12" width="20" height="8" rx="3"></rect>
        <rect class="charm-fill" x="98" y="12" width="20" height="8" rx="3"></rect>
        <circle class="charm-hole" cx="12" cy="16" r="2"></circle>
        <circle class="charm-hole" cx="108" cy="16" r="2"></circle>
      </svg>
    </div>
  </template>

  <template id="charm-whittle">
    <div class="decor-placed decor-charm decor-charm-whittle">
      <svg class="charm-svg" viewBox="0 0 92 70" focusable="false">
        <rect class="charm-fill" x="8" y="36" width="50" height="24" rx="3"></rect>
        <path class="charm-line" d="M14 44h38M14 52h30"></path>
        <rect class="charm-fill" x="58" y="10" width="10" height="22" rx="2.5"></rect>
        <path class="charm-fill" d="M60 30h6l18 24-8 4z"></path>
        <path class="charm-line" d="M76 14c6-6 12 0 8 8"></path>
      </svg>
    </div>
  </template>

  <template id="charm-masks">
    <div class="decor-placed decor-charm decor-charm-masks">
      <svg class="charm-svg" viewBox="0 0 88 52" focusable="false">
        <path class="charm-fill" d="M8 10c10-8 26-8 32 2 2 14-6 28-16 30C14 40 4 28 8 10z"></path>
        <path class="charm-line" d="M18 22h4M30 22h4M18 32c6 6 12 6 18 0"></path>
        <path class="charm-fill" d="M48 10c10-8 26-8 32 2 2 14-6 28-16 30C54 40 44 28 48 10z"></path>
        <path class="charm-line" d="M58 22h4M70 22h4M58 34c6-6 12-6 18 0"></path>
      </svg>
    </div>
  </template>

  <template id="charm-wrench">
    <div class="decor-placed decor-charm decor-charm-wrench">
      <svg class="charm-svg" viewBox="0 0 100 40" focusable="false">
        <path class="charm-line" d="M10 8c-6 0-9 8-4 12 3 3 9 1 11-4h54c1 6 8 9 14 5 5-4 4-12-2-14-3-1-7 0-9 4H19c-1-3-5-3-9-3z"></path>
        <path class="charm-line" d="M16 10v12M88 10v12"></path>
      </svg>
    </div>
  </template>

  <template id="charm-driver">
    <div class="decor-placed decor-charm decor-charm-driver">
      <svg class="charm-svg" viewBox="0 0 28 96" focusable="false">
        <rect class="charm-fill" x="8" y="4" width="12" height="36" rx="4"></rect>
        <rect class="charm-fill" x="12" y="38" width="4" height="46" rx="1"></rect>
        <path class="charm-fill" d="M10 84h8l-4 10z"></path>
      </svg>
    </div>
  </template>

  <template id="charm-bolt">
    <div class="decor-placed decor-charm decor-charm-bolt">
      <svg class="charm-svg" viewBox="0 0 56 56" focusable="false">
        <path class="charm-fill" d="M28 4l18 10v18L28 52 10 32V14z"></path>
        <circle class="charm-hole" cx="28" cy="28" r="8"></circle>
      </svg>
    </div>
  </template>

  <template id="charm-record">
    <div class="decor-placed decor-record-wrap">
      {% include decor_record.liquid class="decor-record" %}
    </div>
  </template>
</div>
