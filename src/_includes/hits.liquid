{% if site.enable_hits_log and site.hits_endpoint %}
  <!-- Persistent hit log (Cloudflare Worker + D1/R2). Private stats: {{ site.hits_endpoint }}/stats -->
  <img
    src="{{ site.hits_endpoint }}/i.gif?p={{ page.url | url_encode }}"
    width="1"
    height="1"
    alt=""
    style="position: absolute; left: -9999px; visibility: hidden"
    referrerpolicy="no-referrer-when-downgrade"
  >
{% endif %}
