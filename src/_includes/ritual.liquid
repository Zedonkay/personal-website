{% assign ritual_pose = include.pose | default: 'companion' %}
<div
  class="ritual ritual--{{ ritual_pose }}"
  data-ritual="{{ ritual_pose }}"
  {% if ritual_pose == 'companion' %}
    role="button"
    tabindex="0"
    aria-label="Ritual, a small brass-and-walnut fox robot. Click to send him running to the other side."
  {% else %}
    role="img"
    aria-label="Ritual, a small brass-and-walnut fox robot"
  {% endif %}
  style="--ritual-sheet: url('{{ '/assets/img/ritual/ritual-idle-wave.webp' | relative_url }}'); --ritual-still: url('{{ '/assets/img/ritual/ritual-idle.png' | relative_url }}'); --ritual-run: url('{{ '/assets/img/ritual/ritual-run-left.webp' | relative_url }}'); --ritual-wait: url('{{ '/assets/img/ritual/ritual-wait.webp' | relative_url }}'); --ritual-jump: url('{{ '/assets/img/ritual/ritual-jump.webp' | relative_url }}'); --ritual-react: url('{{ '/assets/img/ritual/ritual-react.webp' | relative_url }}')"
></div>
