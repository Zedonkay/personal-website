{
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.10.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1"
  },
  "name": "personal-website",
  "version": "1.0.0",
  "description": "Formatting and git-hook tooling for the personal website",
  "main": "purgecss.config.js",
  "scripts": {
    "format": "prettier --config .prettierrc --ignore-path .prettierignore .. --write",
    "format:check": "prettier --config .prettierrc --ignore-path .prettierignore .. --check",
    "prepare": "cd .. && husky",
    "serve": "docker compose -f ../docker/compose.yml up",
    "build": "cd .. && BUNDLE_GEMFILE=src/Gemfile bundle exec jekyll build --config src/_config.yml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zedonkay/personal-website.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Zedonkay/personal-website/issues"
  },
  "homepage": "https://github.com/Zedonkay/personal-website#readme"
}
